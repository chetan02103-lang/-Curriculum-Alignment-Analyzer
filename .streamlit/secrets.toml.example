# Copy this file to  .streamlit/secrets.toml  (that file is git-ignored) and fill it in.
# On Streamlit Community Cloud paste the same lines into: App -> Settings -> Secrets.
# NEVER commit a real key to GitHub. If a key was ever pasted in a chat, issue or commit, revoke it and create a new one.

XAI_API_KEY = "paste-your-xai-key-here"
# XAI_MODEL = "grok-4.7"   # optional: model names change, override here if xAI renames it
